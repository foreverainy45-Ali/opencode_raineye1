{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run RainEye Extension",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "raineye: build",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/opencode-raineye"
      ],
      "outFiles": [
        "${workspaceFolder}/opencode-raineye/dist/**/*.js"
      ]
    }
  ]
}
